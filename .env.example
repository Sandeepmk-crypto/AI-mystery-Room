NODE_ENV=development
PORT=5000

# MongoDB URI (leave empty or use mongodb://127.0.0.1:27017/ai_mystery_room; falls back automatically to in-memory MongoDB if local MongoDB is not running)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Set to true to force deterministic mock AI provider even if GEMINI_API_KEY is present
USE_MOCK_AI=false

CLIENT_ORIGIN=http://localhost:5173

SESSION_TTL_DAYS=7
MEDIA_PROVIDER=placeholder
